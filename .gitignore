# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/

# Testing
coverage/

# Environment (ignore ALL .env files except the shipped templates)
.env
.env.*
!.env.example
!.env.minimal

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Data and storage
data/
media/
uploads/
.wwebjs_auth/
.wwebjs_cache/

# Bridge runtime data (chats, histories, embeddings, allowlist) — never publish.
# Track the empty dir via .gitkeep but ignore everything inside it.
bridge-data/*
!bridge-data/.gitkeep

# Personas: ship only the generic example; a deployer's real persona stays private
personas/*.json
!personas/example.json

# Database
*.db
*.sqlite
*.sqlite3

# Docker
.docker/

# Misc
*.bak
*.tmp
*.temp

# Git worktrees
.worktrees/

# AI Agents
.agent/
