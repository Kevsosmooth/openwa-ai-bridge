# =============================================================================
# OpenWA - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# This is the Single Source of Truth for all configuration.

# =============================================================================
# CORE SETTINGS
# =============================================================================
NODE_ENV=production
API_PORT=2785
LOG_LEVEL=info                      # error | warn | info | debug

# Domain Configuration
DOMAIN=localhost
DASHBOARD_PORT=2886
# Host/IP the dashboard binds to. 127.0.0.1 = this machine only (default, safest).
# Set to your LAN IP (e.g. 192.168.1.50) or 0.0.0.0 to reach it from other devices/phone.
BIND_HOST=127.0.0.1

# Public URLs (for startup banner and external access)
# BASE_URL=https://api.yourdomain.com
# DASHBOARD_URL=https://dashboard.yourdomain.com

# CORS Configuration (comma-separated origins, or * for all)
CORS_ORIGINS=*

# SSL/TLS (enable for production with real domain)
# TRAEFIK_ACME_EMAIL=admin@yourdomain.com
# TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json

# =============================================================================
# COMPONENTS (enable/disable container profiles)
# =============================================================================
DASHBOARD_ENABLED=true              # Enable dashboard container
PROXY_ENABLED=true                  # Enable Traefik proxy container

# =============================================================================
# ENGINE CONFIGURATION
# =============================================================================
# Which WhatsApp engine to use (plugin-based)
# Options: whatsapp-web.js, baileys (future)
ENGINE_TYPE=whatsapp-web.js

# Engine-specific settings
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# =============================================================================
# DATABASE
# =============================================================================
# Options: sqlite, postgres
DATABASE_TYPE=sqlite
POSTGRES_BUILTIN=false              # Use built-in PostgreSQL container?

# PostgreSQL settings (ignored for sqlite, auto-configured if POSTGRES_BUILTIN=true)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=your-secure-password
DATABASE_SYNCHRONIZE=false          # WARNING: Set false in production!
DATABASE_LOGGING=false

# =============================================================================
# REDIS / QUEUE (Phase 2)
# =============================================================================
REDIS_ENABLED=false                 # Enable Redis for queue and caching
REDIS_BUILTIN=false                 # Use built-in Redis container?

# Redis settings (auto-configured if REDIS_BUILTIN=true)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# STORAGE
# =============================================================================
# Options: local, s3
STORAGE_TYPE=local
MINIO_BUILTIN=false                 # Use built-in MinIO container?

# Local storage path (if STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=./data/media

# S3/MinIO settings (if STORAGE_TYPE=s3, auto-configured if MINIO_BUILTIN=true)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openwa
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# =============================================================================
# WEBHOOK
# =============================================================================
WEBHOOK_TIMEOUT=10000               # Timeout in milliseconds
WEBHOOK_MAX_RETRIES=3               # Number of retry attempts
WEBHOOK_RETRY_DELAY=5000            # Delay between retries in ms

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_TTL=60                   # Time window in seconds
RATE_LIMIT_MAX=100                  # Max requests per window

# =============================================================================
# PLUGINS
# =============================================================================
PLUGINS_ENABLED=true                # Enable plugin system
PLUGINS_DIR=./data/plugins          # Plugin directory

# =============================================================================
# SECURITY
# =============================================================================
# Master API key (leave empty to disable, or set to secure value)
API_MASTER_KEY=

# =============================================================================
# DEVELOPER SETTINGS
# =============================================================================
ENABLE_SWAGGER=true                 # Enable API documentation at /api/docs

# =============================================================================
# BRIDGE / AI AUTO-RESPONDER
# =============================================================================
# The "bridge" is the AI brain: it receives incoming WhatsApp messages from the
# gateway, asks Google Gemini for a human-like reply (with memory + persona), and
# sends it back. It is the `bridge` service in docker-compose.override.yml.
# See SETUP.md for the full walkthrough.

# --- Gemini API keys (free at https://aistudio.google.com/apikey) ---
# Provide ONE or MANY. Multiple keys are rotated round-robin with automatic
# back-off when one hits its rate limit, so more keys = higher throughput.
GEMINI_API_KEYS=                    # comma-separated list, e.g. key1,key2,key3 (preferred)
GEMINI_API_KEY=                     # single key (used only if GEMINI_API_KEYS is empty)
GEMINI_MODEL=gemini-2.5-flash       # any Gemini generateContent model

# --- Link the bridge to your gateway session ---
# After you scan the QR in the dashboard, copy these from the gateway.
# Get the API key with: docker exec openwa-api cat /app/data/.api-key
BRIDGE_OPENWA_API_KEY=              # gateway API key (owa_k1_...)
BRIDGE_SESSION_ID=                  # gateway session UUID

# --- Who the bot is allowed to reply to ---
# Comma-separated phone numbers, digits only, with country code, no "+".
# Seeds bridge-data/allowlist.txt on first run; after that edit that file live (no restart).
ALLOWED_NUMBERS=

# --- Persona (the bot's voice) ---
# PERSONA names a file in personas/ (PERSONA=alex -> personas/alex.json). Recommended.
# Copy personas/example.json to personas/<yourname>.json and edit it. See personas/README.md.
PERSONA=
# IANA timezone for time-of-day awareness (e.g. America/New_York). A persona file's own
# "timezone" wins; this is the fallback. Defaults to America/New_York if both are empty.
TIMEZONE=
# Legacy single-line persona, used ONLY when PERSONA is blank. Prefer a persona file.
BRIDGE_SYSTEM_PROMPT=

# --- Self-chat test mode (optional) ---
# Text your OWN number and the bot replies there tagged " --AI", so you can test the
# persona without a second phone. Leave both blank to disable.
SELF_NUMBER=                        # your own number (digits only) — tags the bridge reply
SELF_LIDS=                          # your account's own WhatsApp LID(s), comma-separated (gateway side)

# --- Long-term memory (RAG) — optional, safe defaults baked in ---
EMBED_ENABLED=1                     # 0 to turn off long-term memory entirely
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_MAX_CHARS=8000                # max chars of a message to embed
RETRIEVE_K=4                        # how many past messages to recall per reply
RETRIEVE_MIN_SCORE=0.5              # similarity floor (ranking matters more than this cutoff)
RETRIEVE_ROLES=user                 # roles to recall; 'user' stops the bot echoing its own old wording
HISTORY_TTL_MIN=120                 # minutes of silence before a conversation thread is considered cold
